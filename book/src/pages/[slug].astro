---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Pagination from '../components/Pagination.astro';

export async function getStaticPaths() {
  const chapters = await getCollection('chapters');
  const sorted = chapters.sort((a, b) => a.data.number - b.data.number);

  return sorted.map((chapter, index) => ({
    params: { slug: chapter.slug },
    props: {
      chapter,
      prev: index > 0 ? {
        slug: sorted[index - 1].slug,
        title: sorted[index - 1].data.title,
        number: sorted[index - 1].data.number,
      } : undefined,
      next: index < sorted.length - 1 ? {
        slug: sorted[index + 1].slug,
        title: sorted[index + 1].data.title,
        number: sorted[index + 1].data.number,
      } : undefined,
    },
  }));
}

const { chapter, prev, next } = Astro.props;
const { Content, headings } = await chapter.render();
const { title, number, subtitle, accent } = chapter.data;

const accentColors: Record<string, { gradient: string; glow: string; text: string; badge: string }> = {
  flame:    { gradient: 'from-accent-flame to-accent-ember', glow: 'rgba(255,107,53,0.15)', text: 'text-accent-flame', badge: 'bg-accent-flame/10 text-accent-flame' },
  ember:    { gradient: 'from-accent-ember to-accent-gold', glow: 'rgba(255,140,66,0.15)', text: 'text-accent-ember', badge: 'bg-accent-ember/10 text-accent-ember' },
  gold:     { gradient: 'from-accent-gold to-accent-ember', glow: 'rgba(255,209,102,0.15)', text: 'text-accent-gold', badge: 'bg-accent-gold/10 text-accent-gold' },
  electric: { gradient: 'from-accent-electric to-accent-cyan', glow: 'rgba(6,214,160,0.15)', text: 'text-accent-electric', badge: 'bg-accent-electric/10 text-accent-electric' },
  cyan:     { gradient: 'from-accent-cyan to-accent-electric', glow: 'rgba(17,138,178,0.15)', text: 'text-accent-cyan', badge: 'bg-accent-cyan/10 text-accent-cyan' },
  violet:   { gradient: 'from-accent-violet to-accent-flame', glow: 'rgba(123,47,247,0.15)', text: 'text-accent-violet', badge: 'bg-accent-violet/10 text-accent-violet' },
};

const colors = accentColors[accent] || accentColors.flame;
---

<Base title={`${title} — mill`} description={subtitle}>
  <div class="reading-progress"></div>
  <Nav currentPage="chapter" />

  <!-- Chapter Hero -->
  <header class="relative pt-32 pb-20 lg:pt-40 lg:pb-28 overflow-hidden">
    <!-- Background glow -->
    <div class="absolute inset-0">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full opacity-20 blur-[120px]"
           style={`background: ${colors.glow.replace('0.15', '0.25')}`}></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
      <!-- Chapter number - huge background -->
      <div class="absolute -top-8 -left-4 lg:-top-4 lg:left-4 font-display font-bold text-[12rem] lg:text-[20rem] leading-none text-mill-graphite/20 select-none pointer-events-none">
        {String(number).padStart(2, '0')}
      </div>

      <div class="relative">
        <div class={`inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium mb-6 ${colors.badge}`}>
          <span>Chapter {String(number).padStart(2, '0')}</span>
        </div>

        <h1 class="font-display text-display-xl font-bold text-mill-white mb-4 reveal">
          {title}
        </h1>

        <p class="text-xl lg:text-2xl text-mill-silver max-w-2xl reveal delay-1">
          {subtitle}
        </p>
      </div>
    </div>

    <!-- Decorative line -->
    <div class="absolute bottom-0 left-0 right-0 h-px">
      <div class={`h-full bg-gradient-to-r from-transparent via-current to-transparent opacity-20 ${colors.text}`}></div>
    </div>
  </header>

  <!-- Chapter Content -->
  <main class="max-w-7xl mx-auto px-6 lg:px-8 pb-24">
    <div class="flex gap-12 lg:gap-16">
      <!-- Main content -->
      <article class="flex-1 min-w-0 max-w-3xl">
        <div class="prose-mill">
          <Content />
        </div>

        <Pagination prev={prev} next={next} />
      </article>

      <!-- Table of Contents -->
      <TableOfContents headings={headings} />
    </div>
  </main>

  <Footer />
</Base>
