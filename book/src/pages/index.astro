---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allChapters = await getCollection('chapters');
const chapters = allChapters.sort((a, b) => a.data.chapter - b.data.chapter);

const parts = [
  { number: 'I', title: 'Philosophy', description: 'Why mill exists and what it believes' },
  { number: 'II', title: 'Process', description: 'How intent becomes verified code' },
  { number: 'III', title: 'Practice', description: 'Getting started and day-to-day usage' },
];
---

<Base title="mill">

  <!-- ── Hero ──────────────────────────────────────── -->
  <section class="relative min-h-[85vh] flex flex-col items-center justify-center px-6 overflow-hidden">

    <!-- Orbital process ring -->
    <div class="orbit-container absolute top-1/2 left-1/2 pointer-events-none hidden md:block" aria-hidden="true">
      <!-- Outer ring -->
      <div class="orbit-ring-visual absolute inset-0 rounded-full"></div>
      <!-- Inner ring -->
      <div class="absolute inset-[70px] rounded-full border border-stone-200/15 dark:border-stone-800/15"></div>
      <!-- Center glow -->
      <div class="absolute inset-[35%] rounded-full bg-gradient-radial from-copper-500/[0.04] to-transparent dark:from-copper-500/[0.06]"></div>

      <!-- Orbiting pill nodes -->
      <div class="orbit-node orbit-node-1">
        <div class="orbit-pill">
          <span class="orbit-pill-dot"></span>
          <span class="orbit-pill-label">Ground</span>
        </div>
      </div>
      <div class="orbit-node orbit-node-2">
        <div class="orbit-pill">
          <span class="orbit-pill-dot"></span>
          <span class="orbit-pill-label">Idea</span>
        </div>
      </div>
      <div class="orbit-node orbit-node-3">
        <div class="orbit-pill">
          <span class="orbit-pill-dot"></span>
          <span class="orbit-pill-label">Spec</span>
        </div>
      </div>
      <div class="orbit-node orbit-node-4">
        <div class="orbit-pill">
          <span class="orbit-pill-dot"></span>
          <span class="orbit-pill-label">Ship</span>
        </div>
      </div>
    </div>

    <!-- Hero text -->
    <div class="relative text-center max-w-5xl">
      <!-- Overline -->
      <p class="animate-fade-up text-[11px] font-semibold uppercase tracking-[0.35em] text-copper-700 dark:text-copper-500 mb-10">
        A specification-first delivery system
      </p>

      <!-- Title — each line staggers in -->
      <h1 class="font-display leading-[0.92] mb-10">
        <span class="hero-line block text-5xl sm:text-6xl md:text-7xl lg:text-8xl text-stone-900 dark:text-stone-100 animate-fade-up delay-100">
          Turning intent into
        </span>
        <span class="hero-line block text-5xl sm:text-6xl md:text-7xl lg:text-8xl text-stone-900 dark:text-stone-100 animate-fade-up delay-200">
          verified deliverables,
        </span>
        <span class="hero-line block text-5xl sm:text-6xl md:text-7xl lg:text-8xl text-gradient-copper animate-fade-up" style="animation-delay: 400ms, 1.6s;">
          continuously.
        </span>
      </h1>

      <!-- Description -->
      <p class="animate-fade-up delay-500 text-lg sm:text-xl text-stone-500 dark:text-stone-400 leading-relaxed max-w-xl mx-auto mb-14">
        mill brings structure to AI-assisted development. No more vibe coding.
        Specifications drive execution. Contracts replace conversation.
        Every deliverable is verified.
      </p>

      <!-- CTA — more prominent pill button -->
      <div class="animate-fade-up delay-600">
        <a
          href="#chapters"
          class="group inline-flex items-center gap-3 px-8 py-3 rounded-full border border-copper-600/30 dark:border-copper-500/20 text-sm font-medium uppercase tracking-[0.2em] text-copper-700 dark:text-copper-400 hover:bg-copper-700 hover:border-copper-700 hover:text-white dark:hover:bg-copper-500 dark:hover:border-copper-500 dark:hover:text-stone-950 transition-all duration-300"
        >
          Begin reading
          <svg class="w-4 h-4 transition-transform group-hover:translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Scroll hint -->
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 animate-fade-in delay-700">
      <div class="scroll-hint w-px h-10 bg-gradient-to-b from-transparent via-stone-300 to-stone-300 dark:via-stone-700 dark:to-stone-700"></div>
    </div>
  </section>

  <!-- ── Chapters ──────────────────────────────────── -->
  <section id="chapters" class="max-w-3xl mx-auto px-6 pb-24">

    {parts.map((part, partIndex) => {
      const partChapters = chapters.filter(c => c.data.partNumber === partIndex + 1);
      return (
        <div class="mb-20">
          <!-- Part header -->
          <div class="flex items-baseline gap-4 mb-8">
            <span class="font-display text-5xl text-stone-200 dark:text-stone-800 leading-none select-none">
              {part.number}
            </span>
            <div>
              <h2 class="font-display text-2xl text-stone-900 dark:text-stone-100">
                {part.title}
              </h2>
              <p class="text-sm text-stone-400 dark:text-stone-600 mt-0.5">
                {part.description}
              </p>
            </div>
          </div>

          <!-- Chapter list -->
          <div class="space-y-1">
            {partChapters.map(chapter => (
              <a
                href={`/${chapter.slug}`}
                class="group flex items-baseline gap-4 py-4 px-4 -mx-4 rounded-lg hover:bg-stone-100/60 dark:hover:bg-stone-900/40 transition-colors"
              >
                <span class="text-sm font-mono text-stone-300 dark:text-stone-700 tabular-nums shrink-0 w-7 text-right">
                  {String(chapter.data.chapter).padStart(2, '0')}
                </span>
                <div class="flex-1 min-w-0">
                  <h3 class="font-display text-xl text-stone-800 dark:text-stone-200 group-hover:text-copper-700 dark:group-hover:text-copper-400 transition-colors">
                    {chapter.data.title}
                  </h3>
                  <p class="text-sm text-stone-400 dark:text-stone-600 mt-0.5 truncate">
                    {chapter.data.description}
                  </p>
                </div>
                <span class="text-stone-300 dark:text-stone-700 group-hover:text-copper-500 transition-colors shrink-0">
                  &rarr;
                </span>
              </a>
            ))}
          </div>

          {partIndex < parts.length - 1 && (
            <div class="rule-copper mt-16"></div>
          )}
        </div>
      );
    })}
  </section>

</Base>
