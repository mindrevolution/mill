---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;
const filteredHeadings = headings.filter(h => h.depth <= 3);
---

<aside class="hidden xl:block sticky top-28 self-start" id="toc">
  <div class="pl-8 border-l border-mill-graphite/30">
    <h4 class="font-display text-xs font-semibold text-mill-ash uppercase tracking-widest mb-6">
      On this page
    </h4>
    <nav class="space-y-1">
      {filteredHeadings.map((heading) => (
        <a
          href={`#${heading.slug}`}
          class:list={[
            'toc-link block py-1.5 text-sm transition-all duration-300 hover:text-accent-flame',
            heading.depth === 2 ? 'text-mill-silver font-medium' : 'text-mill-ash pl-4 text-xs',
          ]}
          data-slug={heading.slug}
        >
          {heading.text}
        </a>
      ))}
    </nav>
  </div>
</aside>

<script>
  // Active heading tracking
  const tocLinks = document.querySelectorAll('.toc-link');
  const headingElements: Element[] = [];

  tocLinks.forEach((link) => {
    const slug = link.getAttribute('data-slug');
    if (slug) {
      const heading = document.getElementById(slug);
      if (heading) headingElements.push(heading);
    }
  });

  const tocObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          tocLinks.forEach((link) => {
            link.classList.remove('text-accent-flame', '!text-accent-flame');
            if (link.getAttribute('data-slug') === entry.target.id) {
              link.classList.add('!text-accent-flame');
            }
          });
        }
      });
    },
    { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
  );

  headingElements.forEach((el) => tocObserver.observe(el));
</script>
