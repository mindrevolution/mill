<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Mill</RootNamespace>
    <AssemblyName>mill</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.5.0-alpha</Version>
    <ApplicationIcon>mill.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- AOT only for Release builds (Debug uses JIT for fast inner loop) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="mill.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Generate compile-time version constant (avoids reflection for AOT) -->
  <Target Name="GenerateVersionInfo" BeforeTargets="CoreCompile">
    <WriteLinesToFile
      File="$(IntermediateOutputPath)ThisAssembly.g.cs"
      Lines="internal static class ThisAssembly { internal const string Version = &quot;$(Version)&quot;%3B }"
      Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)ThisAssembly.g.cs" />
    </ItemGroup>
  </Target>

</Project>
